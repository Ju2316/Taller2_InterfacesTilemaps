--- !u!114 &984376226
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 984376218}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 980da63f9ed559c48b28d5086c790f10, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  DialogoMar: {fileID: 1182373512}
  dialoguePanel: {fileID: 1950375913}
  dialogueText: {fileID: 1949127383}
  dialogueLines:
  - "Aldeano: \xA1Por fin llega, guardabosques! Qu\xE9 bueno verlo por aqu\xED, ya empezaba a oscurecerce bastante."
  - 'Guardabosques: Buenas tardes. El camino estuvo tranquilo y todo se ve en orden por el sendero.'
  - "Aldeano: Menos mal. Muchas gracias por cuidar del bosque y de nosotros; espero que su estancia en la caba\xF1a sea agradable y que todo marche bien durante su turno."
  sistemaPuntos: {fileID: 1436827821}
  dialogueLinesMisionCompleta:
  - "Aldeano: \xA1Lo lograste! Gracias por ayudar a reforestar el bosque."
